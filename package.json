{
  "name": "sala-limpa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "demo": "vite --host 127.0.0.1 --mode demo",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node scripts/browser-qa.mjs",
    "test:live": "firebase emulators:exec --project demo-sala-limpa --only auth,firestore \"node scripts/live-qa.mjs\"",
    "test:rules": "firebase emulators:exec --project demo-sala-limpa --only firestore \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "firebase": "^13.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase-tools": "^15.35.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "playwright": "^1.65.0",
    "@axe-core/playwright": "^4.14.0"
  }
}
