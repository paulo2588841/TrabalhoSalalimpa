# Copie para .env.local. Configuração pública do app Web Firebase, nunca senha ou chave privada.
# Deixe os campos vazios para usar o modo demonstrativo local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Local: /. GitHub Pages em um repositório: /nome-do-repositorio/
VITE_BASE_PATH=/
# Apenas para testes locais contra os emuladores (nunca habilite no deploy).
VITE_USE_FIREBASE_EMULATORS=false
